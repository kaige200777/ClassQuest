# 生产环境配置文件
# 注意：主要配置参数已统一到config.py文件中
# 本文件仅用于需要覆盖config.py默认值时使用

# 服务器配置（可选，覆盖config.py中的默认值）
# APP_HOST=0.0.0.0
# APP_PORT=8000

# Waitress服务器配置（可选，覆盖config.py中的默认值）
# WAITRESS_THREADS=8

# 日志配置（可选，覆盖config.py中的默认值）
# LOG_DIR=logs
# LOG_FILE=app.log

# Flask配置（可选，覆盖config.py中的默认值）
# FLASK_ENV=production
# FLASK_DEBUG=false
# SECRET_KEY=your-production-secret-key-change-this

# 数据库配置（可选，覆盖config.py中的默认值）
# DATABASE_URI=sqlite:///test_system.db

# 配置说明：
# 1. 主要配置参数请在config.py文件中修改
# 2. 本文件中的配置会覆盖config.py中的默认值
# 3. 如果需要使用本文件，请将其复制为.env
# 4. AI批改配置、图片上传配置等都在config.py中